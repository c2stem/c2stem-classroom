# Used only by `npm run serve`. Requests to /spice-api/ are proxied to
# https://spice.c2-stem.org by the dev server (vue.config.js), so local
# development does not hit the production server's CORS restriction.
# Override in .env.development.local (git-ignored), e.g. for a local server:
#   VUE_APP_API_URL=http://localhost:8203/
VUE_APP_API_URL=/spice-api/
